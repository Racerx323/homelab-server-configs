# J1-SVMF ReconYa v0.26.0 application configuration.
# Copy to /home/pi/reconya/.env, replace both credential placeholders on the
# target, and keep the installed file mode 0600. Never commit the live file.

# Required database configuration
DATABASE_NAME="reconya-dev"
SQLITE_PATH=data/reconya.db

# Web service
PORT=3008

# Required credentials; replace both values before starting ReconYa.
LOGIN_USERNAME=REPLACE_WITH_LOGIN_USERNAME
LOGIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Outbound application lookups remain disabled. IEEE OUI data is supplied by
# the repository-managed reconya-oui-update.timer instead.
PUBLIC_IP_LOOKUP_ENABLED=false
GEOLOCATION_ENABLED=false
VENDOR_LOOKUP_ONLINE_ENABLED=false
OUI_DOWNLOAD_ENABLED=false

# Raise a host-unreachable alert after this many hours.
ALERT_OFFLINE_THRESHOLD_HOURS=6
