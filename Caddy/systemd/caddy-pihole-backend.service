[Unit]
Description=Protected Pi-hole backend for the DNS VIP owner
Wants=network-online.target
After=network-online.target lighttpd.service
Requires=lighttpd.service

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/pihole-backend/backend.env
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/pihole-backend/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/pihole-backend/Caddyfile --adapter caddyfile --force
TimeoutStopSec=30s
LimitNOFILE=1048576
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/caddy/pihole-backend
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
