#!/usr/bin/env bash

set -Eeuo pipefail
set +x
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
readonly PATH

readonly finalizer=/usr/local/libexec/finalize-incoming-release-v2.sh

usage() {
    printf 'Usage: %s --source-role node-a|node-b\n' "${0##*/}" >&2
}

require_check() {
    local check_label=$1

    shift
    if "$@"; then
        return 0
    fi
    printf 'caddy_sync_receiver_v2_check_%s=false\n' "$check_label" >&2
    return 1
}

if [[ "${1:-}" == --self-test && $# -eq 1 ]]; then
    printf 'caddy_sync_release_receiver_v2_self_test_complete=true\n'
    exit 0
fi

if [[ $# -ne 2 || "$1" != --source-role ||
    ! "$2" =~ ^node-[ab]$ ]]; then
    usage
    exit 126
fi

readonly source_role=$2
readonly receiver_root="/var/lib/caddy-sync/incoming/$source_role"
readonly command_value=${SSH_ORIGINAL_COMMAND:-}

if [[ "$command_value" != rsync\ --server\ * ]]; then
    printf 'Only the rsync server protocol is permitted.\n' >&2
    exit 126
fi

if [[ "$command_value" == *--delete* ]]; then
    printf 'Remote deletion is not permitted.\n' >&2
    exit 126
fi

require_check identity_caddy_sync test "$(id -un)" = caddy-sync
require_check finalizer_regular test -f "$finalizer"
require_check finalizer_not_symlink test ! -L "$finalizer"
require_check finalizer_executable test -x "$finalizer"
install -d -m 0750 "$receiver_root"
require_check receiver_root_regular_directory test -d "$receiver_root"
require_check receiver_root_not_symlink test ! -L "$receiver_root"

receiver_status=0
/usr/bin/rrsync -wo -no-del "$receiver_root" || receiver_status=$?
if [[ "$receiver_status" -ne 0 ]]; then
    exit "$receiver_status"
fi

"$finalizer" --source-role "$source_role"
