(pihole_ui_local) {
	import local_tls
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		health_uri /admin/
		health_interval 30s
		health_timeout 3s
		health_follow_redirects
	}
}

(pihole_ui_dns_owner) {
	import local_tls
	encode zstd gzip
	reverse_proxy https://10.1.0.55:8443 https://[fd36:5aa8:6971:1::55]:8443 {
		lb_policy first
		health_uri /admin/
		health_interval 30s
		health_timeout 3s
		health_follow_redirects
		transport http {
			tls_server_name pihole-backend.local.theama.co
			tls_trust_pool file {$PIHOLE_BACKEND_SERVER_CA_FILE}
			tls_client_auth {$PIHOLE_BACKEND_CLIENT_CERT_FILE} {$PIHOLE_BACKEND_CLIENT_KEY_FILE}
		}
	}
}

pihole-admin.local.theama.co {
	bind 10.1.0.56 fd36:5aa8:6971:1::56
	import pihole_ui_dns_owner
}

{$NODE_FQDN} {
	bind {$NODE_IPV4} {$NODE_IPV6}
	import pihole_ui_local
}
