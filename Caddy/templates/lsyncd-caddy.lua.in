settings {
    logfile = "/dev/stdout",
    statusFile = "/run/caddy-lsyncd/status",
    statusInterval = 10,
    insist = true,
    maxProcesses = 1
}

sync {
    default.rsyncssh,
    source = "/var/lib/caddy-sync/outbound/",
    host = "@PEER_FQDN@",
    targetdir = "/@NODE_ROLE@/",
    delay = 5,
    delete = false,
    rsync = {
        archive = true,
        compress = true,
        _extra = {
            "--partial",
            "--delay-updates",
            "--exclude=*.tmp",
            "--exclude=*.swp",
            "--exclude=.git/",
            "--exclude=state/",
            "--exclude=quarantine/"
        }
    },
    ssh = {
        port = 22,
        identityFile = "/var/lib/caddy-sync/.ssh/id_ed25519",
        options = {
            BatchMode = "yes",
            IdentitiesOnly = "yes",
            StrictHostKeyChecking = "yes",
            UserKnownHostsFile = "/var/lib/caddy-sync/.ssh/known_hosts",
            ConnectTimeout = "5"
        }
    }
}
