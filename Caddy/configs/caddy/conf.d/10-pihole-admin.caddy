(pihole_ui) {
	import local_tls
	@caddy_health path /healthz
	handle @caddy_health {
		respond 204
	}
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080 {
			health_uri /admin/
			health_interval 30s
			health_timeout 3s
			health_follow_redirects
		}
	}
}

pihole-admin.local.theama.co {
	bind 10.1.0.56 fd36:5aa8:6971:1::56
	import pihole_ui
}

{$NODE_FQDN} {
	bind {$NODE_IPV4} {$NODE_IPV6}
	import pihole_ui
}
