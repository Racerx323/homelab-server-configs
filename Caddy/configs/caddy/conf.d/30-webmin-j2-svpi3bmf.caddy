# Proposed application fragment; not part of the accepted Caddy release.
https://webmin-j2-svpi3bmf.local.theama.co {
    bind 10.1.0.56 fd36:5aa8:6971:1::56 {$NODE_IPV4} {$NODE_IPV6}
    import local_tls

    @allowed_clients remote_ip 10.1.0.0/22 fd36:5aa8:6971:1::/64
    handle @allowed_clients {
        reverse_proxy 127.0.0.1:18075 {

            health_method GET
            health_uri /robots.txt
            health_status 200
            health_interval 30s
            health_timeout 5s
            health_passes 1
            health_fails 3
            health_headers {
                X-Homelab-Health webmin-browser-health
                Host webmin-j2-svpi3bmf.local.theama.co
                X-Forwarded-Host webmin-j2-svpi3bmf.local.theama.co
                X-Forwarded-Proto https
                User-Agent homelab-proxy-diagnostic
                Accept */*
                Accept-Encoding identity
                Connection close
            }

            header_up Host webmin-j2-svpi3bmf.local.theama.co

            transport http {
                dial_timeout 3s
                response_header_timeout 60s
                # Avoid idle HTTP reuse races; WebSocket upgrades remain supported.
                keepalive off
            }
        }
    }

    respond 403
}
