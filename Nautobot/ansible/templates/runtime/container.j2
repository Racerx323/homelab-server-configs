[Unit]
Description=Nautobot {{ name }}
{% if service.depends_on is defined %}
Requires={{ dependencies | join(" ") }}
After={{ dependencies | join(" ") }}
{% endif %}

[Container]
LogDriver=journald
Image={{ image }}
Pull=never
ContainerName=nautobot-{{ name }}
Network=nautobot-private.network
NetworkAlias={{ name }}
EnvironmentFile=/var/lib/nautobot/runtime/{{ name }}.env
{% if name == "worker" %}
Environment=NAUTOBOT_CELERY_HEALTH_PROBES_AS_FILES=true
{% endif %}
{% if name in ['migration', 'web', 'worker', 'scheduler'] %}
{% if initialization | default(false) and name == "migration" %}
Entrypoint=python3
{% if continuation | default(none) %}
Volume=/var/lib/nautobot/runtime/migration-continuation.py:/run/migration-continuation.py:ro
Volume=/var/lib/nautobot/runtime/migration-continuation-inputs.json:/run/migration-continuation-inputs.json:ro
Volume=/var/lib/nautobot/runtime/continuation-evidence:/run/continuation-evidence:rw
Environment=CONTINUATION_TOKEN={{ continuation }}
Environment=PYTHONUNBUFFERED=1
{% else %}
Volume=/var/lib/nautobot/runtime/initialize-application.py:/run/initialize-application.py:ro
{% endif %}
Tmpfs=/opt/nautobot/git:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/jobs:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/media:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/static:rw,size=256m,mode=1777
Environment=PYTHONDONTWRITEBYTECODE=1
PodmanArgs=--memory-swap=1536m
{% else %}
# Pass only the systemd invocation identity, not the host environment.
PodmanArgs=--env=INVOCATION_ID
Entrypoint=python3
Exec=/run/startup-application.py {{ name }}
Volume=/var/lib/nautobot/runtime/startup-application.py:/run/startup-application.py:ro
Volume=/var/lib/nautobot/runtime/startup-command.py:/run/startup-command.py:ro
Volume=/var/lib/nautobot/runtime/startup-job.py:/opt/nautobot/jobs/startup_readiness.py:ro
Volume=/var/lib/nautobot/runtime/startup-job-probe.py:/run/startup-job-probe.py:ro
Volume=/var/lib/nautobot/runtime/initialize-application.py:/run/initialize-application.py:ro
User=999
Group=999
ReadOnly=true
# Private per-container metric files; discarded on container recreation.
Tmpfs=/prom_cache:rw,size=16m,mode=1777,noexec,nosuid,nodev
Environment=PROMETHEUS_MULTIPROC_DIR=/prom_cache
Environment=prometheus_multiproc_dir=/prom_cache
Tmpfs=/opt/nautobot/git:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/jobs:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/static:rw,size=256m,mode=1777
Tmpfs=/tmp:rw,size=64m,mode=1777
Environment=PYTHONDONTWRITEBYTECODE=1
PodmanArgs=--memory-swap={{ service.memory_limit_mib }}m
{% endif %}
Environment=NAUTOBOT_CONFIG=/opt/nautobot/nautobot_config.py
Volume=/var/lib/nautobot/runtime/nautobot_config.py:/opt/nautobot/nautobot_config.py:ro
{% endif %}
{% for volume in volumes %}
Volume=nautobot-{{ volume.name }}.volume:{{ volume.destination }}
{% endfor %}
{% for endpoint in service.published_endpoints | default([]) %}
PublishPort={{ '[' + endpoint.address + ']' if endpoint.family == 'ipv6' else endpoint.address }}:{{ endpoint.port }}:8080
{% endfor %}
{% if service.memory_limit_mib is defined %}
PodmanArgs=--memory={{ service.memory_limit_mib }}m
{% endif %}
{% if name == 'postgresql' %}
Environment=POSTGRES_USER=nautobot
Environment=POSTGRES_DB=nautobot
HealthCmd=pg_isready -U nautobot -d nautobot
Notify=healthy
HealthInterval=10s
HealthRetries=6
{% elif name == 'redis' %}
Secret=nautobot-redis-config,type=mount,target=redis.conf,uid=999,gid=999,mode=0400
Exec=redis-server /run/secrets/redis.conf
HealthCmd=/bin/sh -c 'test "$(redis-cli --raw ping)" = PONG'
Notify=healthy
HealthInterval=10s
HealthRetries=6
{% elif initialization | default(false) %}
Exec={{ '/run/migration-continuation.py' if continuation | default(none) and name == 'migration' else command }}
{% endif %}

[Service]
{% if name == 'web' %}
# Cross-system/user boundary: root-owned readback, never a user-unit After= alias.
ExecStartPre=/usr/bin/sudo -n /usr/bin/python3 -I /usr/local/lib/nautobot-network/backend_guard.py check
{% endif %}
{% if name in ["migration", "web", "worker", "scheduler"] %}
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ "nautobot-initialization" if initialization | default(false) else "nautobot-" + name }}
{% endif %}
{% if name == 'migration' %}
Type=oneshot
RemainAfterExit=yes
Restart=no
{% else %}
Restart=on-failure
RestartSec=10
{% endif %}
TimeoutStartSec={{ 1860 if continuation | default(none) and name == "migration" else (900 if initialization | default(false) and name == "migration" else (300 if name == "migration" else (480 if name in ["web", "worker", "scheduler"] else 300))) }}
TimeoutStopSec=90

{% if name != 'migration' %}
[Install]
WantedBy=default.target
{% endif %}
