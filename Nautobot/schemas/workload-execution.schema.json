{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "execution_authorized",
    "operation_id",
    "root",
    "boot_id",
    "journal_cursor",
    "baseline_review",
    "backup"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "const": "workload_qualification"
    },
    "execution_authorized": {
      "type": "boolean"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "root": {
      "type": "string",
      "pattern": "^/tmp/nautobot-workload\\.[0-9a-f]{32}$"
    },
    "boot_id": {
      "type": "string",
      "format": "uuid"
    },
    "journal_cursor": {
      "type": "string",
      "minLength": 1
    },
    "baseline_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "boot_id",
        "services",
        "reviewed_at",
        "evidence_sha256"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "boot_id": {
          "type": "string",
          "format": "uuid"
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postgresql",
            "redis",
            "web",
            "worker",
            "scheduler"
          ],
          "properties": {
            "postgresql": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory_max",
                "invocation"
              ],
              "properties": {
                "memory_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "redis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory_max",
                "invocation"
              ],
              "properties": {
                "memory_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "web": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory_max",
                "invocation"
              ],
              "properties": {
                "memory_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "worker": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory_max",
                "invocation"
              ],
              "properties": {
                "memory_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "scheduler": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "memory_max",
                "invocation"
              ],
              "properties": {
                "memory_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "invocation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "argv",
        "receipt"
      ],
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed workload execution input; exact bundle authorization required"
}
