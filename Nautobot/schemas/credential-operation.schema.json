{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded credential provisioning definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "authorization", "target", "doppler", "scope", "boundaries"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "state", "authorization_ready"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
        "stage": {"const": "credential_provisioning"},
        "state": {"const": "definition"},
        "authorization_ready": {"const": true}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_authorized", "method"],
      "properties": {
        "mutation_authorized": {"const": false},
        "method": {"const": "separate_explicit_approval_of_frozen_bundle_sha256"}
      }
    },
    "target": {"const": "j2-svpi4mf"},
    "doppler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "environment", "config"],
      "properties": {
        "project": {"const": "homelab-dev"},
        "environment": {"const": "prd"},
        "config": {"const": "prd_nautobot"}
      }
    },
    "scope": {
      "const": [
        "create_four_application_secrets",
        "inject_six_protected_environments",
        "inject_nonsecret_settings",
        "create_redis_podman_secret"
      ]
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_deployment", "administrator_creation", "restic_changes", "overwrite_existing"],
      "properties": {
        "runtime_deployment": {"const": false},
        "administrator_creation": {"const": false},
        "restic_changes": {"const": false},
        "overwrite_existing": {"const": false}
      }
    }
  }
}
