{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded credential provisioning definition",
  "const": {
    "schema_version": 1,
    "operation": {
      "id": "nautobot-credentials-v1",
      "stage": "credential_provisioning",
      "state": "definition",
      "authorization_ready": true
    },
    "authorization": {
      "mutation_authorized": false,
      "method": "separate_explicit_approval_of_frozen_bundle_sha256"
    },
    "target": "j2-svpi4mf",
    "doppler": {
      "project": "homelab-dev",
      "environment": "prd",
      "config": "prd_nautobot"
    },
    "scope": [
      "create_four_application_secrets",
      "inject_six_protected_environments",
      "inject_nonsecret_settings",
      "create_redis_podman_secret"
    ],
    "boundaries": {
      "runtime_deployment": false,
      "administrator_creation": false,
      "restic_changes": false,
      "overwrite_existing": false
    }
  }
}
