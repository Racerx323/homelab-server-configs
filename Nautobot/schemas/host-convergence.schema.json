{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed read-only host convergence definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "storage_evidence",
    "expected",
    "preflight",
    "mutations",
    "acceptance",
    "authorization",
    "component_ownership"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "authorization_ready", "stage", "target", "architecture", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^nautobot-host-baseline-convergence-[a-z0-9-]+$"},
        "state": {"enum": ["definition", "terminal-pending"]},
        "authorization_ready": {"type": "boolean"},
        "stage": {"const": "host_baseline_convergence"},
        "target": {"const": {"host": "j2-svpi4mf", "address": "10.1.2.170", "ssh_user": "ama"}},
        "architecture": {"const": {"plan": "Nautobot/docs/NAUTOBOT_DEPLOYMENT_PLAN.md"}},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "base_commit"],
          "properties": {
            "repository": {"const": "homelab-server-configs"},
            "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      }
    },
    "storage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_boot_validation", "storage_window_boot_id"],
      "properties": {
        "current_boot_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "boot_id", "evidence_reference"],
          "properties": {
            "state": {"enum": ["required", "passed", "failed"]},
            "boot_id": {"type": ["string", "null"]},
            "evidence_reference": {"type": ["string", "null"]}
          }
        },
        "storage_window_boot_id": {"type": "string", "format": "uuid"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "uid",
        "gid",
        "home",
        "shell",
        "subordinate_start",
        "subordinate_count",
        "required_units",
        "unwanted_units",
        "listeners",
        "optional_listeners",
        "root_source",
        "root_fstype",
        "permanent_ula",
        "quirk_token",
        "maximum_temperature_celsius"
      ],
      "properties": {
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "podman",
            "uidmap",
            "passt",
            "slirp4netns",
            "fuse-overlayfs",
            "crun",
            "dbus-user-session",
            "smartmontools",
            "restic",
            "msmtp",
            "msmtp-mta",
            "bsd-mailx",
            "liblockfile-bin",
            "liblockfile1:arm64",
            "needrestart"
          ],
          "properties": {
            "podman": {"type": "string", "minLength": 1, "maxLength": 200},
            "uidmap": {"type": "string", "minLength": 1, "maxLength": 200},
            "passt": {"type": "string", "minLength": 1, "maxLength": 200},
            "slirp4netns": {"type": "string", "minLength": 1, "maxLength": 200},
            "fuse-overlayfs": {"type": "string", "minLength": 1, "maxLength": 200},
            "crun": {"type": "string", "minLength": 1, "maxLength": 200},
            "dbus-user-session": {"type": "string", "minLength": 1, "maxLength": 200},
            "smartmontools": {"type": "string", "minLength": 1, "maxLength": 200},
            "restic": {"type": "string", "minLength": 1, "maxLength": 200},
            "msmtp": {"type": "string", "minLength": 1, "maxLength": 200},
            "msmtp-mta": {"type": "string", "minLength": 1, "maxLength": 200},
            "bsd-mailx": {"type": "string", "minLength": 1, "maxLength": 200},
            "liblockfile-bin": {"type": "string", "minLength": 1, "maxLength": 200},
            "liblockfile1:arm64": {"type": "string", "minLength": 1, "maxLength": 200},
            "needrestart": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "uid": {"const": 999},
        "gid": {"const": 985},
        "home": {"const": "/var/lib/nautobot"},
        "shell": {"const": "/usr/sbin/nologin"},
        "subordinate_start": {"const": 165536},
        "subordinate_count": {"const": 65536},
        "required_units": {
          "const": [
            "ssh.service",
            "NetworkManager.service",
            "systemd-timesyncd.service",
            "munin-node.service",
            "webmin.service",
            "watchdog.service"
          ]
        },
        "unwanted_units": {
          "const": ["avahi-daemon.service", "avahi-daemon.socket", "bluetooth.service", "ModemManager.service"]
        },
        "listeners": {
          "const": [
            "tcp LISTEN 0.0.0.0:22 0.0.0.0:*",
            "tcp LISTEN [::]:22 [::]:*",
            "tcp LISTEN 0.0.0.0:10000 0.0.0.0:*",
            "tcp LISTEN [::]:10000 [::]:*",
            "tcp LISTEN *:4949 *:*",
            "udp UNCONN 0.0.0.0:10000 0.0.0.0:*"
          ]
        },
        "optional_listeners": {"const": ["tcp LISTEN 127.0.0.1:555 0.0.0.0:*"]},
        "root_source": {"const": "/dev/sda2"},
        "root_fstype": {"const": "ext4"},
        "permanent_ula": {"const": "fd36:5aa8:6971:1::170"},
        "quirk_token": {"const": "usb-storage.quirks=152d:0583:u"},
        "maximum_temperature_celsius": {"const": 80}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "execution_authorized",
        "playbook",
        "evaluator",
        "probe_timeout_seconds",
        "stream_limit_bytes",
        "probes"
      ],
      "properties": {
        "read_only": {"const": true},
        "execution_authorized": {"type": "boolean"},
        "playbook": {"const": "Nautobot/ansible/playbooks/preflight-host-convergence.yaml"},
        "evaluator": {"const": "Nautobot/ansible/scripts/evaluate-host-convergence.py"},
        "probe_timeout_seconds": {"const": 30},
        "stream_limit_bytes": {"const": 4194304},
        "probes": {
          "const": [
            {
              "id": "privilege",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/true"
              ]
            },
            {
              "id": "boot_start",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/proc/sys/kernel/random/boot_id"
              ]
            },
            {
              "id": "packages",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/dpkg-query",
                "--show",
                "--showformat=${binary:Package}\t${Version}\t${db:Status-Status}\n"
              ]
            },
            {
              "id": "passwd",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/getent",
                "passwd",
                "nautobot"
              ]
            },
            {
              "id": "identity",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/id",
                "nautobot"
              ]
            },
            {
              "id": "home",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/stat",
                "--format=%u:%g:%a:%F",
                "/var/lib/nautobot"
              ]
            },
            {
              "id": "subuid",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/etc/subuid"
              ]
            },
            {
              "id": "subgid",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/etc/subgid"
              ]
            },
            {
              "id": "linger",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/loginctl",
                "show-user",
                "nautobot",
                "--property=UID",
                "--property=Linger",
                "--property=State"
              ]
            },
            {
              "id": "podman",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/sbin/runuser",
                "--user",
                "nautobot",
                "--",
                "/usr/bin/env",
                "--chdir=/var/lib/nautobot",
                "/usr/bin/podman",
                "info",
                "--format=json"
              ]
            },
            {
              "id": "cgroup_controllers",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/sys/fs/cgroup/cgroup.controllers"
              ]
            },
            {
              "id": "units",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/systemctl",
                "show",
                "--property=Id,LoadState,ActiveState,UnitFileState",
                "ssh.service",
                "NetworkManager.service",
                "systemd-timesyncd.service",
                "munin-node.service",
                "webmin.service",
                "watchdog.service",
                "avahi-daemon.service",
                "avahi-daemon.socket",
                "bluetooth.service",
                "ModemManager.service",
                "keepalived.service"
              ]
            },
            {
              "id": "failed_units",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/systemctl",
                "--failed",
                "--no-legend",
                "--no-pager",
                "--plain"
              ]
            },
            {
              "id": "keepalived_unit_files",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/systemctl",
                "list-unit-files",
                "--no-legend",
                "--no-pager",
                "keepalived*"
              ]
            },
            {
              "id": "keepalived_units",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/systemctl",
                "list-units",
                "--all",
                "--no-legend",
                "--no-pager",
                "--plain",
                "keepalived*"
              ]
            },
            {
              "id": "keepalived_process",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/pgrep",
                "--exact",
                "keepalived"
              ]
            },
            {
              "id": "keepalived_config",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/test",
                "-e",
                "/etc/keepalived"
              ]
            },
            {
              "id": "keepalived_config_symlink",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/test",
                "-L",
                "/etc/keepalived"
              ]
            },
            {
              "id": "addresses",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/sbin/ip",
                "-json",
                "address",
                "show",
                "dev",
                "eth0"
              ]
            },
            {
              "id": "root",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/findmnt",
                "--json",
                "--output=SOURCE,FSTYPE,TARGET",
                "/"
              ]
            },
            {
              "id": "cmdline",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/proc/cmdline"
              ]
            },
            {
              "id": "usb",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/udevadm",
                "info",
                "--attribute-walk",
                "/dev/sda"
              ]
            },
            {
              "id": "storage_events",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/journalctl",
                "--boot=0",
                "--dmesg",
                "--grep=reset.*USB|USB.*reset|I/O error|Buffer I/O|EXT4-fs error|uas_eh_|device reset|Out of memory|oom-kill|under-voltage|over-current",
                "--output=short-iso",
                "--no-pager",
                "--quiet"
              ]
            },
            {
              "id": "smart",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/sbin/smartctl",
                "--json",
                "-q",
                "noserial",
                "-H",
                "-i",
                "-A",
                "-l",
                "error",
                "/dev/sda"
              ]
            },
            {
              "id": "smart_settle",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "90s",
                "/usr/bin/sleep",
                "75"
              ]
            },
            {
              "id": "post_smart_storage_events",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/journalctl",
                "--boot=0",
                "--dmesg",
                "--grep=reset.*USB|USB.*reset|I/O error|Buffer I/O|EXT4-fs error|uas_eh_|device reset|Out of memory|oom-kill|under-voltage|over-current",
                "--output=short-iso",
                "--no-pager",
                "--quiet"
              ]
            },
            {
              "id": "ext4_errors",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/sys/fs/ext4/sda2/errors_count"
              ]
            },
            {
              "id": "ext4_metadata",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/sbin/tune2fs",
                "-l",
                "/dev/sda2"
              ]
            },
            {
              "id": "temperature",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/vcgencmd",
                "measure_temp"
              ]
            },
            {
              "id": "throttling",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/vcgencmd",
                "get_throttled"
              ]
            },
            {
              "id": "listeners",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/ss",
                "--listening",
                "--tcp",
                "--udp",
                "--numeric",
                "--no-header"
              ]
            },
            {
              "id": "residue",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/apt-get",
                "--simulate",
                "autoremove"
              ]
            },
            {
              "id": "boot_end",
              "argv": [
                "/usr/bin/sudo",
                "-n",
                "/usr/bin/timeout",
                "--signal=TERM",
                "--kill-after=5s",
                "30s",
                "/usr/bin/cat",
                "/proc/sys/kernel/random/boot_id"
              ]
            }
          ]
        }
      }
    },
    "mutations": {
      "const": {
        "ordered": [],
        "automatic_correction": false,
        "automatic_baseline_replay": false,
        "automatic_rollback": false
      }
    },
    "acceptance": {
      "const": {
        "accepted_live_path": "Nautobot/manifests/accepted-live-state.yaml",
        "contract": "Nautobot/docs/OPERATIONS.md",
        "require_independent_review": true,
        "require_all_preflight_checks": true,
        "drift_action": "stop_and_define_only_exact_required_correction",
        "runtime_acceptance": false,
        "restic_initialization_authorized": false
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "mutation_authorized", "blockers"],
      "properties": {
        "command": {"const": "run-host-convergence.py_execute-snapshot_AUTHORIZED_SHA256"},
        "mutation_authorized": {"const": false},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "component_ownership": {
      "const": {
        "needrestart": {
          "owner": "Needrestart/",
          "procedure": "Needrestart/README.md",
          "scope": "package_and_notification_integration",
          "nautobot_scope": "observe_required_package_version_only",
          "changes_require_owner_review": true
        }
      }
    }
  }
}
