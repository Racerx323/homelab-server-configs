{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.theama.co/schemas/nautobot-storage-diagnostic-v1.json",
  "title": "Nautobot active storage diagnostic operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "incident",
    "collection",
    "decision",
    "evidence",
    "authorization"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "authorization_ready",
        "stage",
        "target",
        "architecture",
        "source"
      ],
      "properties": {
        "id": { "const": "nautobot-storage-diagnostic-v1" },
        "state": { "enum": ["definition", "pending"] },
        "authorization_ready": { "type": "boolean" },
        "stage": { "const": "storage_diagnostic" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "address", "ssh_user"],
          "properties": {
            "host": { "const": "j2-svpi4mf" },
            "address": { "const": "10.1.2.170" },
            "ssh_user": { "const": "ama" }
          }
        },
        "architecture": { "type": "object" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "base_commit"],
          "properties": {
            "repository": { "const": "homelab-server-configs" },
            "base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "incident": {
      "type": "object",
      "required": [
        "predecessor_operation",
        "terminal_tag",
        "operation_started_at_utc",
        "first_storage_event_at_utc",
        "recurrence_observation_start_utc",
        "root_device",
        "power_path",
        "storage_adapter",
        "observed_events"
      ]
    },
    "collection": {
      "type": "object",
      "required": [
        "read_only",
        "privilege_model",
        "stream_limit_bytes",
        "journal_line_limit",
        "observation_start_utc",
        "areas",
        "prohibited"
      ],
      "properties": {
        "read_only": { "const": true },
        "privilege_model": {
          "const": "ansible_unprivileged_explicit_sudo_n"
        },
        "stream_limit_bytes": { "type": "integer", "minimum": 1048576 },
        "journal_line_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "areas": { "type": "array", "minItems": 6, "uniqueItems": true },
        "prohibited": { "type": "array", "minItems": 7, "uniqueItems": true }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "state",
        "operator_choice_required",
        "retain_for_observation_requires",
        "rollback_if",
        "boundaries"
      ],
      "properties": {
        "state": { "const": "pending_evidence" },
        "operator_choice_required": { "const": true },
        "retain_for_observation_requires": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true
        },
        "rollback_if": { "type": "array", "minItems": 7, "uniqueItems": true },
        "boundaries": { "type": "array", "minItems": 4, "uniqueItems": true }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "local_root_pattern",
        "directory_mode",
        "file_mode",
        "raw_evidence_in_git",
        "records"
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "command",
        "bundle_algorithm",
        "authorized_stage",
        "mutation_authorized",
        "excluded_stages",
        "blockers"
      ],
      "properties": {
        "bundle_algorithm": { "const": "sha256" },
        "authorized_stage": { "const": "storage_diagnostic" },
        "mutation_authorized": { "const": false },
        "excluded_stages": { "type": "array", "minItems": 9, "uniqueItems": true },
        "blockers": { "type": "array", "uniqueItems": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "properties": { "authorization_ready": { "const": true } },
            "required": ["authorization_ready"]
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "properties": { "state": { "const": "pending" } }
          },
          "authorization": {
            "properties": { "blockers": { "maxItems": 0 } }
          }
        }
      }
    }
  ]
}
