{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.theama.co/schemas/nautobot-operation.json",
  "title": "Nautobot operation state",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorization_ready"],
          "properties": {
            "state": {"const": "clean"},
            "authorization_ready": {"const": false}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "predecessor",
        "verification",
        "dataset",
        "restic_repository",
        "workflow",
        "acceptance",
        "failure_and_cleanup",
        "evidence",
        "authorization"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "state",
            "authorization_ready",
            "stage",
            "target",
            "architecture",
            "source"
          ],
          "properties": {
            "id": {"const": "nautobot-isolated-backup-restore-v1"},
            "state": {"enum": ["definition", "pending"]},
            "authorization_ready": {"type": "boolean"},
            "stage": {"const": "backup_restore_verification"},
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "address", "ssh_user", "execution_user"],
              "properties": {
                "host": {"const": "j2-svpi4mf"},
                "address": {"const": "10.1.2.170"},
                "ssh_user": {"const": "ama"},
                "execution_user": {"const": "nautobot"}
              }
            },
            "architecture": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "storage_decision", "restic"],
              "properties": {
                "plan": {"const": "Nautobot/docs/NAUTOBOT_DEPLOYMENT_PLAN.md"},
                "storage_decision": {"const": "Nautobot/docs/STORAGE_REMEDIATION_DECISION.md"},
                "restic": {"const": "restic/docs/RESTIC_ARCHITECTURE.md"}
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "base_commit"],
              "properties": {
                "repository": {"const": "homelab-server-configs"},
                "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          }
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "terminal_tag", "definition_commit", "bundle_sha256", "result"],
          "properties": {
            "operation": {"const": "nautobot-storage-soak-verification-v1"},
            "terminal_tag": {"const": "nautobot-storage-soak-verification-v1-passed"},
            "definition_commit": {"const": "eb38b4923ba6bfbc4f458870b6555a6e39d91f77"},
            "bundle_sha256": {"const": "e3a94ecd20ee5070b86e92f6cf4e16faa56762cca3cfec4dc4e31492dc538305"},
            "result": {"const": "storage_soak_healthy_isolated_restore_pending"}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "purpose",
            "satisfies_storage_predata_gate_only",
            "satisfies_full_nautobot_recovery_acceptance",
            "full_nautobot_restore_test_still_required_during_pilot"
          ],
          "properties": {
            "kind": {"const": "deterministic_predata_canary"},
            "purpose": {"const": "verify_off_host_backup_integrity_and_isolated_restore_path"},
            "satisfies_storage_predata_gate_only": {"const": true},
            "satisfies_full_nautobot_recovery_acceptance": {"const": false},
            "full_nautobot_restore_test_still_required_during_pilot": {"const": true}
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_root_pattern",
            "restore_root_pattern",
            "directory_mode",
            "file_mode",
            "require_root_filesystem",
            "files"
          ],
          "properties": {
            "source_root_pattern": {"const": "/var/lib/nautobot/backup-restore-tests/source.*"},
            "restore_root_pattern": {"const": "/var/lib/nautobot/backup-restore-tests/restore.*"},
            "directory_mode": {"const": "0700"},
            "file_mode": {"const": "0600"},
            "require_root_filesystem": {"const": "/dev/sda2"},
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "content_utf8", "sha256"],
                "properties": {
                  "path": {"const": "predata/canary.txt"},
                  "content_utf8": {"const": "nautobot isolated backup restore verification v1\n"},
                  "sha256": {"const": "0b8fefbdc586f053d6e69ee230d119d668e2dc7f4739fe61a334227d61142de2"}
                }
              }
            }
          }
        },
        "restic_repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "transport",
            "dedicated_private_bucket_required",
            "endpoint",
            "bucket",
            "prefix",
            "repository_id",
            "initialization_owner",
            "repository_initialized_state",
            "credentials",
            "repository_password_recovery_location_confirmed"
          ],
          "properties": {
            "provider": {"const": "backblaze_b2"},
            "transport": {"const": "s3_compatible"},
            "dedicated_private_bucket_required": {"const": true},
            "endpoint": {"$ref": "#/$defs/unresolvedIdentity"},
            "bucket": {"$ref": "#/$defs/unresolvedIdentity"},
            "prefix": {"$ref": "#/$defs/unresolvedIdentity"},
            "repository_id": {"$ref": "#/$defs/preflightIdentity"},
            "initialization_owner": {"$ref": "#/$defs/unresolvedIdentity"},
            "repository_initialized_state": {"enum": ["unresolved", "existing", "new"]},
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "references",
                "values_allowed_in_git_or_evidence",
                "bucket_scoped_capabilities_required"
              ],
              "properties": {
                "provider": {"const": "approved_secrets_system"},
                "references": {
                  "const": [
                    "restic_repository_password",
                    "backblaze_b2_application_key_id",
                    "backblaze_b2_application_key"
                  ]
                },
                "values_allowed_in_git_or_evidence": {"const": false},
                "bucket_scoped_capabilities_required": {
                  "const": ["list", "read", "write", "delete"]
                }
              }
            },
            "repository_password_recovery_location_confirmed": {"type": "boolean"}
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_tag",
            "snapshot_selection",
            "integrity_check",
            "restore_selection",
            "restore_target",
            "journal_scope",
            "focused_storage_event_pattern",
            "retain_remote_snapshot_until_terminal_acceptance",
            "automatic_remote_snapshot_deletion",
            "ordered_actions"
          ],
          "properties": {
            "snapshot_tag": {"const": "nautobot-predata-canary-v1"},
            "snapshot_selection": {"const": "exact_set_difference_from_snapshots_json"},
            "integrity_check": {"const": "restic_check_read_data"},
            "restore_selection": {"const": "exact_snapshot_id"},
            "restore_target": {"const": "isolated_empty_owned_directory"},
            "journal_scope": {"const": "cursor_bounded"},
            "focused_storage_event_pattern": {
              "const": "I/O error|Buffer I/O|EXT4-fs error|uas_eh_|device reset"
            },
            "retain_remote_snapshot_until_terminal_acceptance": {"const": true},
            "automatic_remote_snapshot_deletion": {"const": false},
            "ordered_actions": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require", "boundaries"],
          "properties": {
            "require": {"type": "array", "minItems": 1, "uniqueItems": true},
            "boundaries": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "failure_and_cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_upload_failure",
            "post_upload_failure",
            "restore_failure",
            "automatic_repository_repair",
            "automatic_snapshot_forget_or_prune",
            "automatic_live_path_restore",
            "cleanup_requires_exact_owned_paths_and_preserved_evidence"
          ],
          "properties": {
            "pre_upload_failure": {"const": "remove_only_proven_owned_local_test_directories"},
            "post_upload_failure": {"const": "retain_remote_snapshot_and_local_evidence_for_review"},
            "restore_failure": {"const": "retain_remote_snapshot_and_local_evidence_for_review"},
            "automatic_repository_repair": {"const": false},
            "automatic_snapshot_forget_or_prune": {"const": false},
            "automatic_live_path_restore": {"const": false},
            "cleanup_requires_exact_owned_paths_and_preserved_evidence": {"const": true}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_root_pattern",
            "directory_mode",
            "file_mode",
            "stream_limit_bytes",
            "raw_evidence_in_git",
            "secret_values_in_evidence",
            "records"
          ],
          "properties": {
            "local_root_pattern": {"const": "/tmp/nautobot-backup-restore.*"},
            "directory_mode": {"const": "0700"},
            "file_mode": {"const": "0600"},
            "stream_limit_bytes": {"type": "integer", "minimum": 1048576},
            "raw_evidence_in_git": {"const": false},
            "secret_values_in_evidence": {"const": false},
            "records": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "bundle_algorithm",
            "authorized_stage",
            "mutation_authorized",
            "excluded_stages",
            "blockers"
          ],
          "properties": {
            "command": {"type": ["string", "null"]},
            "bundle_algorithm": {"const": "sha256"},
            "authorized_stage": {"const": "backup_restore_verification"},
            "mutation_authorized": {"type": "boolean"},
            "excluded_stages": {"type": "array", "minItems": 1, "uniqueItems": true},
            "blockers": {"type": "array", "uniqueItems": true}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "definition"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": false}}
              },
              "authorization": {
                "properties": {
                  "command": {"const": null},
                  "mutation_authorized": {"const": false},
                  "blockers": {"minItems": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "pending"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": true}}
              },
              "restic_repository": {
                "properties": {
                  "endpoint": {
                    "properties": {"resolved": {"const": true}},
                    "required": ["value"]
                  },
                  "bucket": {
                    "properties": {"resolved": {"const": true}},
                    "required": ["value"]
                  },
                  "prefix": {
                    "properties": {"resolved": {"const": true}},
                    "required": ["value"]
                  },
                  "repository_id": {
                    "properties": {"resolved": {"const": true}},
                    "required": ["value"]
                  },
                  "initialization_owner": {
                    "properties": {"resolved": {"const": true}},
                    "required": ["value"]
                  },
                  "repository_initialized_state": {"const": "existing"},
                  "repository_password_recovery_location_confirmed": {"const": true}
                }
              },
              "authorization": {
                "properties": {
                  "command": {"type": "string", "minLength": 1},
                  "mutation_authorized": {"const": true},
                  "blockers": {"maxItems": 0}
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "unresolvedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved", "source"],
      "properties": {
        "resolved": {"type": "boolean"},
        "source": {"const": "reviewed_nonsecret_operation_input"},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"resolved": {"const": true}},
            "required": ["resolved"]
          },
          "then": {"required": ["value"]}
        },
        {
          "if": {
            "properties": {"resolved": {"const": false}},
            "required": ["resolved"]
          },
          "then": {"not": {"required": ["value"]}}
        }
      ]
    },
    "preflightIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved", "source"],
      "properties": {
        "resolved": {"type": "boolean"},
        "source": {"const": "read_only_restic_repository_id_preflight"},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"resolved": {"const": true}},
            "required": ["resolved"]
          },
          "then": {"required": ["value"]}
        },
        {
          "if": {
            "properties": {"resolved": {"const": false}},
            "required": ["resolved"]
          },
          "then": {"not": {"required": ["value"]}}
        }
      ]
    }
  }
}
