{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.theama.co/schemas/nautobot-operation.json",
  "title": "Nautobot operation state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorization_ready"],
          "properties": {
            "state": {"const": "clean"},
            "authorization_ready": {"const": false}
          }
        },
        {
          "type": "object",
          "required": ["id", "state", "authorization_ready", "stage", "target", "architecture", "source"],
          "properties": {
            "id": {"const": "nautobot-uas-quirk-v2"},
            "state": {"enum": ["definition", "pending"]},
            "authorization_ready": {"type": "boolean"},
            "stage": {"const": "storage_remediation"},
            "target": {
              "type": "object",
              "required": ["host", "address", "ssh_user"],
              "properties": {
                "host": {"const": "j2-svpi4mf"},
                "address": {"const": "10.1.2.170"},
                "ssh_user": {"const": "ama"}
              }
            },
            "architecture": {"type": "object"},
            "source": {
              "type": "object",
              "required": ["repository", "base_commit"],
              "properties": {
                "repository": {"const": "homelab-server-configs"},
                "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          }
        }
      ]
    },
    "predecessor": {
      "type": "object",
      "required": ["operation", "terminal_tag", "definition_commit", "bundle_sha256", "result"],
      "properties": {
        "operation": {"const": "nautobot-uas-quirk-v1"},
        "terminal_tag": {"const": "nautobot-uas-quirk-v1-rolled-back-action-required"},
        "definition_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result": {"const": "rolled_back_storage_action_required"}
      }
    },
    "deferred_operation": {
      "type": "object",
      "required": ["id", "definition_checkpoint", "reusable_launcher", "reusable_playbook", "resume_only_after"],
      "properties": {
        "id": {"const": "nautobot-host-baseline-rollback-v1"},
        "definition_checkpoint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "resume_only_after": {"const": "storage_remediation_accepted"}
      }
    },
    "preflight": {
      "type": "object",
      "required": ["command", "read_only", "maximum_age_minutes", "status", "evidence_manifest_sha256", "completed_at_utc", "require_local_console_recovery", "local_console_recovery_confirmed", "require_current_backup", "current_backup_confirmed", "expected"],
      "properties": {
        "read_only": {"const": true},
        "maximum_age_minutes": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "passed"]},
        "evidence_manifest_sha256": {"type": ["null", "string"], "pattern": "^[0-9a-f]{64}$"},
        "completed_at_utc": {"type": ["null", "string"], "format": "date-time"},
        "require_local_console_recovery": {"const": true},
        "local_console_recovery_confirmed": {"type": "boolean"},
        "require_current_backup": {"const": true},
        "current_backup_confirmed": {"type": "boolean"},
        "expected": {"type": "object"}
      }
    },
    "mutation": {
      "type": "object",
      "required": ["boot_cmdline_path", "backup_path", "create_backup", "reuse_verified_backup", "append_token", "preserve_single_logical_line", "preserve_no_trailing_newline", "reboot_once", "reboot_timeout_seconds"],
      "properties": {
        "boot_cmdline_path": {"const": "/boot/firmware/cmdline.txt"},
        "create_backup": {"const": false},
        "reuse_verified_backup": {"const": true},
        "append_token": {"const": "usb-storage.quirks=152d:0583:u"},
        "preserve_single_logical_line": {"const": true},
        "preserve_no_trailing_newline": {"const": true},
        "reboot_once": {"const": true},
        "reboot_timeout_seconds": {"type": "integer", "minimum": 120, "maximum": 600}
      }
    },
    "acceptance": {"type": "object", "required": ["immediate", "soak"]},
    "rollback": {
      "type": "object",
      "required": ["trigger", "ordered", "automatic_when_host_reachable", "manual_console_required_when_host_unreachable", "expected_restored_sha256", "preserve_backup_until_terminal_acceptance"],
      "properties": {
        "automatic_when_host_reachable": {"const": true},
        "manual_console_required_when_host_unreachable": {"const": true},
        "expected_restored_sha256": {"const": "c1e8648e70a13b54a7c0e9a3c030838cebdc478d88b8c938ebce67f980d6f22f"},
        "preserve_backup_until_terminal_acceptance": {"const": true}
      }
    },
    "evidence": {"type": "object"},
    "authorization": {
      "type": "object",
      "required": ["command", "bundle_algorithm", "authorized_stage", "excluded_stages", "blockers"],
      "properties": {
        "bundle_algorithm": {"const": "sha256"},
        "authorized_stage": {"const": "storage_remediation"},
        "blockers": {"type": "array", "uniqueItems": true}
      }
    }
  },
  "allOf": [{
    "if": {
      "properties": {
        "operation": {"required": ["id"]}
      }
    },
    "then": {
      "required": ["predecessor", "deferred_operation", "preflight", "mutation", "acceptance", "rollback", "evidence", "authorization"]
    }
  }, {
    "if": {"properties": {"operation": {"properties": {"authorization_ready": {"const": true}}}}},
    "then": {
      "properties": {
        "operation": {"properties": {"state": {"const": "pending"}}},
        "preflight": {"properties": {"status": {"const": "passed"}, "local_console_recovery_confirmed": {"const": true}, "current_backup_confirmed": {"const": true}, "evidence_manifest_sha256": {"type": "string"}, "completed_at_utc": {"type": "string"}}},
        "authorization": {"properties": {"blockers": {"maxItems": 0}}}
      }
    }
  }]
}
