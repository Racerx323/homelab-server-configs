{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.theama.co/schemas/nautobot-operation.json",
  "title": "Nautobot operation state",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorization_ready"],
          "properties": {
            "state": {"const": "clean"},
            "authorization_ready": {"const": false}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "predecessor",
        "operator_applied_remediation",
        "diagnostic_storage",
        "collection",
        "decision",
        "evidence",
        "authorization"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "state",
            "authorization_ready",
            "stage",
            "target",
            "architecture",
            "source"
          ],
          "properties": {
            "id": {"const": "nautobot-storage-diagnostic-v2"},
            "state": {"enum": ["definition", "pending"]},
            "authorization_ready": {"type": "boolean"},
            "stage": {"const": "storage_diagnostic"},
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "address", "ssh_user"],
              "properties": {
                "host": {"const": "j2-svpi4mf"},
                "address": {"const": "10.1.2.170"},
                "ssh_user": {"const": "ama"}
              }
            },
            "architecture": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "decision"],
              "properties": {
                "plan": {"const": "Nautobot/docs/NAUTOBOT_DEPLOYMENT_PLAN.md"},
                "decision": {"const": "Nautobot/docs/STORAGE_REMEDIATION_DECISION.md"}
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "base_commit"],
              "properties": {
                "repository": {"const": "homelab-server-configs"},
                "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          }
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "terminal_tag",
            "definition_commit",
            "bundle_sha256",
            "result"
          ],
          "properties": {
            "operation": {"const": "nautobot-uas-quirk-v3"},
            "terminal_tag": {"const": "nautobot-uas-quirk-v3-rolled-back-operator-applied"},
            "definition_commit": {"const": "f5ce8344ab6f4c2035a617cad4684603586b8c9f"},
            "bundle_sha256": {"const": "0899f68448ca28696044174c7a55fe68621ffdcc29c274f6782aa15875322336"},
            "result": {"const": "rolled_back_ambiguous_broad_gate"}
          }
        },
        "operator_applied_remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "quirk_token", "immediate_observations"],
          "properties": {
            "state": {"const": "immediately_effective_soak_pending"},
            "quirk_token": {"const": "usb-storage.quirks=152d:0583:u"},
            "immediate_observations": {"type": "object"}
          }
        },
        "diagnostic_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_device",
            "root_source",
            "root_filesystem",
            "quirk_token",
            "usb_vendor_id",
            "usb_product_id",
            "expected_driver",
            "expected_link_mbps"
          ],
          "properties": {
            "root_device": {"const": "/dev/sda"},
            "root_source": {"const": "/dev/sda2"},
            "root_filesystem": {"const": "ext4"},
            "quirk_token": {"const": "usb-storage.quirks=152d:0583:u"},
            "usb_vendor_id": {"const": "152d"},
            "usb_product_id": {"const": "0583"},
            "expected_driver": {"const": "usb-storage"},
            "expected_link_mbps": {"const": 5000}
          }
        },
        "collection": {
          "type": "object",
          "required": [
            "read_only",
            "privilege_model",
            "current_boot_only",
            "journal_line_limit",
            "focused_storage_event_pattern",
            "preserve_exact_matched_lines",
            "stream_limit_bytes",
            "areas",
            "prohibited"
          ],
          "properties": {
            "read_only": {"const": true},
            "privilege_model": {"const": "ansible_unprivileged_explicit_sudo_n"},
            "current_boot_only": {"const": true},
            "journal_line_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
            "focused_storage_event_pattern": {
              "const": "I/O error|Buffer I/O|EXT4-fs error|uas_eh_|device reset"
            },
            "preserve_exact_matched_lines": {"const": true},
            "stream_limit_bytes": {"type": "integer", "minimum": 1048576},
            "areas": {"type": "array", "minItems": 1, "uniqueItems": true},
            "prohibited": {
              "type": "array",
              "contains": {"const": "reboot"},
              "uniqueItems": true
            }
          }
        },
        "decision": {
          "type": "object",
          "required": [
            "state",
            "immediate_baseline_only",
            "minimum_24_hour_soak_complete",
            "require_operator_review",
            "require",
            "boundaries"
          ],
          "properties": {
            "state": {"const": "pending_evidence"},
            "immediate_baseline_only": {"const": true},
            "minimum_24_hour_soak_complete": {"const": false},
            "require_operator_review": {"const": true},
            "require": {"type": "array", "minItems": 1, "uniqueItems": true},
            "boundaries": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "local_root_pattern",
            "directory_mode",
            "file_mode",
            "raw_evidence_in_git",
            "exact_focused_event_lines_recorded_in",
            "records"
          ],
          "properties": {
            "local_root_pattern": {"const": "/tmp/nautobot-storage-diagnostic.*"},
            "directory_mode": {"const": "0700"},
            "file_mode": {"const": "0600"},
            "raw_evidence_in_git": {"const": false},
            "exact_focused_event_lines_recorded_in": {"const": "kernel.log"},
            "records": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "bundle_algorithm",
            "authorized_stage",
            "mutation_authorized",
            "excluded_stages",
            "blockers"
          ],
          "properties": {
            "command": {"type": "string"},
            "bundle_algorithm": {"const": "sha256"},
            "authorized_stage": {"const": "storage_diagnostic"},
            "mutation_authorized": {"const": false},
            "excluded_stages": {"type": "array", "minItems": 1, "uniqueItems": true},
            "blockers": {"type": "array", "uniqueItems": true}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "definition"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": false}}
              },
              "authorization": {
                "properties": {"blockers": {"minItems": 1}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "pending"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": true}}
              },
              "authorization": {
                "properties": {"blockers": {"maxItems": 0}}
              }
            }
          }
        }
      ]
    }
  ]
}
