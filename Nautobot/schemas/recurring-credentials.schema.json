{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recurring backup credential provisioning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "target",
    "plan_sha256",
    "accepted_prerequisite",
    "baseline",
    "provider",
    "delivery",
    "boundaries",
    "external_inputs",
    "acceptance",
    "rollback",
    "later_stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "const": {
        "host": "j2-svpi4mf",
        "address": "10.1.2.170",
        "ssh_user": "ama",
        "uid": 999,
        "gid": 985
      }
    },
    "provider": {
      "const": {
        "project": "homelab-dev",
        "environment": "prd",
        "parent": "prd",
        "config": "prd_nautobot_backup",
        "references": {
          "NAUTOBOT_RESTIC_REPOSITORY_PASSWORD": "${homelab-dev.prd_restic.NAUTOBOT_RESTIC_REPOSITORY_PASSWORD}",
          "NAUTOBOT_RESTIC_B2_APPLICATION_KEY_ID": "${homelab-dev.prd_b2.NAUTOBOT_RESTIC_B2_APPLICATION_KEY_ID}",
          "NAUTOBOT_RESTIC_B2_APPLICATION_KEY": "${homelab-dev.prd_b2.NAUTOBOT_RESTIC_B2_APPLICATION_KEY}"
        },
        "metadata_names": [
          "DOPPLER_CONFIG",
          "DOPPLER_ENVIRONMENT",
          "DOPPLER_PROJECT"
        ],
        "token_name": "nautobot-recurring-backup",
        "access": "read",
        "max_age": "2160h",
        "rotation_owner": "Aaron (homelab operator)",
        "rotation_lead_days": 14
      }
    },
    "delivery": {
      "const": {
        "directory": "/var/lib/nautobot/protection/credentials",
        "token_file": "/var/lib/nautobot/protection/credentials/doppler-service-token",
        "metadata_file": "/var/lib/nautobot/protection/credentials/metadata.json",
        "directory_mode": "0700",
        "file_mode": "0600"
      }
    },
    "boundaries": {
      "const": {
        "canonical_secret_changes": false,
        "application_credentials": false,
        "packages": false,
        "service_changes": false,
        "capture": false,
        "notifications": false,
        "timers": false,
        "reboot": false
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "state",
        "authorization_ready",
        "execution_enabled",
        "source_commit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "recurring_credential_provisioning"
        },
        "state": {
          "const": "pending"
        },
        "authorization_ready": {
          "type": "boolean"
        },
        "execution_enabled": {
          "type": "boolean"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_tag",
        "bundle_sha256",
        "execution_review_sha256"
      ],
      "properties": {
        "terminal_tag": {
          "type": "string",
          "minLength": 1
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "mapped_media"
      ],
      "properties": {
        "artifact_sha256": {
          "type": "object",
          "minProperties": 15,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "mapped_media": {
          "type": "object",
          "minProperties": 2
        }
      }
    },
    "external_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "later_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
