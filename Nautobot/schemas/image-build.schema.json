{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared bounded ARM64 image qualification; external hash approval required",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "authorization", "build", "boundaries"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "state", "authorization_ready"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
        "stage": {"const": "image_qualification"},
        "state": {"const": "definition"},
        "authorization_ready": {"const": true}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_authorized", "method", "preparation_only"],
      "properties": {
        "mutation_authorized": {"const": false},
        "method": {"const": "separate_explicit_approval_of_frozen_bundle_sha256"},
        "preparation_only": {"const": true}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host", "base_image", "input_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "host": {"const": "j2-svpi4mf"},
        "base_image": {
          "const": "docker.io/networktocode/nautobot@sha256:5273234a7589f92084d159711feb48ac69da027de9854426857ae3afc88a5aa7"
        },
        "input_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Containerfile", "requirements.lock"],
          "properties": {
            "Containerfile": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "requirements.lock": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "operation_sha256",
            "bundle_sha256",
            "id",
            "result_sha256",
            "terminal_evidence_sha256"
          ],
          "properties": {
            "repository": {"const": "/home/aaron/code/homelab-server-configs"},
            "tag": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
            "operation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
            "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "terminal_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_deployment",
        "production_credentials",
        "production_store_load",
        "public_registry_push",
        "cleanup_or_prune"
      ],
      "properties": {
        "runtime_deployment": {"const": false},
        "production_credentials": {"const": false},
        "production_store_load": {"const": false},
        "public_registry_push": {"const": false},
        "cleanup_or_prune": {"const": false}
      }
    }
  }
}
