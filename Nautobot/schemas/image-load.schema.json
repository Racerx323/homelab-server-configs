{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed image-only load operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "authorization",
    "target",
    "archive",
    "ordered_actions",
    "limits",
    "boundaries",
    "source_base_commit",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "state", "authorization_ready"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
        "stage": {"const": "image_loading"},
        "state": {"const": "definition"},
        "authorization_ready": {"const": true}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_authorized", "method"],
      "properties": {
        "mutation_authorized": {"const": false},
        "method": {"const": "separate_explicit_approval_of_frozen_bundle_sha256"}
      }
    },
    "target": {"const": "j2-svpi4mf"},
    "archive": {"type": "string", "pattern": "^/var/tmp/nautobot-image-[0-9a-f]{12}/work/image[.]oci[.]tar$"},
    "ordered_actions": {
      "const": [
        "preflight",
        "load_custom",
        "verify_loaded",
        "assign_local_alias",
        "verify_custom_reference",
        "pull_verify_postgresql",
        "pull_verify_redis",
        "postflight"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_quota_percent",
        "memory_max_bytes",
        "swap_max_bytes",
        "command_timeout_seconds",
        "post_exit_seconds",
        "sample_interval_seconds",
        "max_sample_gap_seconds",
        "minimum_free_bytes",
        "minimum_available_bytes"
      ],
      "properties": {
        "cpu_quota_percent": {"const": 200},
        "memory_max_bytes": {"const": 3221225472},
        "swap_max_bytes": {"const": 0},
        "command_timeout_seconds": {"const": 900},
        "post_exit_seconds": {"const": 75},
        "sample_interval_seconds": {"const": 5},
        "max_sample_gap_seconds": {"const": 15},
        "minimum_free_bytes": {"const": 21474836480},
        "minimum_available_bytes": {"const": 1610612736}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_deployment",
        "administrator_creation",
        "restic_changes",
        "credential_changes",
        "automatic_image_removal"
      ],
      "properties": {
        "runtime_deployment": {"const": false},
        "administrator_creation": {"const": false},
        "restic_changes": {"const": false},
        "credential_changes": {"const": false},
        "automatic_image_removal": {"const": false}
      }
    },
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
