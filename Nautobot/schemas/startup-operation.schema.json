{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed single-host application startup operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "prerequisites",
    "scope",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "stage",
        "id",
        "authorization_ready",
        "target"
      ],
      "properties": {
        "state": {
          "const": "definition"
        },
        "stage": {
          "const": "application_startup"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "authorization_ready": {
          "const": true
        },
        "target": {
          "const": "j2-svpi4mf"
        }
      }
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preservation_tag",
        "preservation_commit",
        "bootstrap_tag",
        "network_packet_tag"
      ],
      "properties": {
        "preservation_tag": {
          "const": "nautobot-startup-preservation-v1-accepted"
        },
        "preservation_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bootstrap_tag": {
          "const": "nautobot-administrator-bootstrap-v2-accepted"
        },
        "network_packet_tag": {
          "const": "nautobot-packet-qualification-accepted"
        }
      }
    },
    "scope": {
      "const": {
        "success": "running_pending_workload_acceptance",
        "failure": "stopped_data_retained",
        "automatic_restore": false,
        "reboot": false,
        "caddy_publication": false
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
