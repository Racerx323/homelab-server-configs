{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "plan_sha256",
    "root",
    "baseline",
    "artifacts",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "stage",
        "id",
        "target",
        "authorization_ready",
        "source_commit"
      ],
      "properties": {
        "state": {
          "const": "definition"
        },
        "stage": {
          "const": "boot_readiness"
        },
        "id": {
          "const": "nautobot-boot-readiness-v1"
        },
        "target": {
          "const": "j2-svpi4mf"
        },
        "authorization_ready": {
          "const": true
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root": {
      "type": "string",
      "pattern": "^/var/lib/nautobot/boot-readiness\\.[0-9a-f]{32}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "boot_id",
        "artifact_sha256",
        "services",
        "sessions"
      ],
      "properties": {
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "boot_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postgresql",
            "redis",
            "web",
            "worker",
            "scheduler"
          ],
          "properties": {
            "postgresql": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InvocationID",
                "NRestarts"
              ],
              "properties": {
                "InvocationID": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "NRestarts": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "redis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InvocationID",
                "NRestarts"
              ],
              "properties": {
                "InvocationID": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "NRestarts": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "web": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InvocationID",
                "NRestarts"
              ],
              "properties": {
                "InvocationID": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "NRestarts": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "worker": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InvocationID",
                "NRestarts"
              ],
              "properties": {
                "InvocationID": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "NRestarts": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "scheduler": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InvocationID",
                "NRestarts"
              ],
              "properties": {
                "InvocationID": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "NRestarts": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          }
        },
        "sessions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "Id",
              "User",
              "Service",
              "Class",
              "Leader",
              "State"
            ],
            "properties": {
              "Id": {
                "type": "string"
              },
              "User": {
                "type": "string"
              },
              "Service": {
                "type": "string"
              },
              "Class": {
                "type": "string"
              },
              "Leader": {
                "type": "string"
              },
              "State": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "destination",
          "before_sha256",
          "after_sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "boundaries": {
      "const": {
        "restart": false,
        "reboot": false,
        "database_write": false,
        "backup_or_restore": false
      }
    }
  }
}
