---
- name: Start one runtime service without implicit retry
  ansible.builtin.command:
    argv: '{{ startup_user_command + ["/usr/bin/systemctl", "--user", "start", "--no-block", "nautobot-" + startup_role + ".service"] }}'
  changed_when: true
  no_log: true
- name: Require completed migration or healthy running service
  ansible.builtin.command:
    argv: ['/usr/bin/sudo', '-n', '/usr/bin/python3', '{{ startup_evidence }}/startup-node.py', state, '{{ startup_role }}']
  register: startup_service_state
  changed_when: false
  until: startup_service_state.rc == 0 or ((startup_service_state.stdout | from_json).terminal | default(false))
  failed_when: false
  retries: '{{ 444 if startup_role == "migration" else 108 }}'
  delay: 5
  no_log: true
- name: Reject terminal service failure before starting another role
  ansible.builtin.assert:
    that: startup_service_state.rc == 0
    fail_msg: Service reached terminal failure; stop progression and retain diagnostics.
- name: Require a new service invocation
  ansible.builtin.assert:
    that:
      - (startup_service_state.stdout | from_json).state.InvocationID != startup_before[startup_role].InvocationID
  no_log: true
