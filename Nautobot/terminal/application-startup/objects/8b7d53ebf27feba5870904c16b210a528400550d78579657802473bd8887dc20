[Unit]
Description=Nautobot web
Requires=nautobot-migration.service
After=nautobot-migration.service

[Container]
Image=localhost/nautobot-homelab@sha256:ceb4d6dfa82db1e70d472c01260d980d9e7497d9c8185d6bd7716e5d377856bf
Pull=never
ContainerName=nautobot-web
Network=nautobot-private.network
NetworkAlias=web
EnvironmentFile=/var/lib/nautobot/runtime/web.env
Entrypoint=python3
Exec=/run/startup-application.py web
Volume=/var/lib/nautobot/runtime/startup-application.py:/run/startup-application.py:ro
Volume=/var/lib/nautobot/runtime/startup-command.py:/run/startup-command.py:ro
Volume=/var/lib/nautobot/runtime/startup-job.py:/opt/nautobot/jobs/startup_readiness.py:ro
Volume=/var/lib/nautobot/runtime/startup-job-probe.py:/run/startup-job-probe.py:ro
Volume=/var/lib/nautobot/runtime/initialize-application.py:/run/initialize-application.py:ro
User=999
Group=999
ReadOnly=true
# Private per-container metric files; discarded on container recreation.
Tmpfs=/prom_cache:rw,size=16m,mode=1777,noexec,nosuid,nodev
Environment=PROMETHEUS_MULTIPROC_DIR=/prom_cache
Environment=prometheus_multiproc_dir=/prom_cache
Tmpfs=/opt/nautobot/git:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/jobs:rw,size=16m,mode=1777
Tmpfs=/opt/nautobot/static:rw,size=256m,mode=1777
Tmpfs=/tmp:rw,size=64m,mode=1777
Environment=PYTHONDONTWRITEBYTECODE=1
PodmanArgs=--memory-swap=1536m
Environment=NAUTOBOT_CONFIG=/opt/nautobot/nautobot_config.py
Volume=/var/lib/nautobot/runtime/nautobot_config.py:/opt/nautobot/nautobot_config.py:ro
Volume=nautobot-nautobot_media.volume:/opt/nautobot/media
PublishPort=10.1.2.170:8080:8080
PublishPort=[fd36:5aa8:6971:1::170]:8080:8080
PublishPort=127.0.0.1:8080:8080
PodmanArgs=--memory=1536m

[Service]
# Cross-system/user boundary: root-owned readback, never a user-unit After= alias.
ExecStartPre=/usr/bin/sudo -n /usr/bin/python3 -I /usr/local/lib/nautobot-network/backend_guard.py check
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nautobot-web
Restart=on-failure
RestartSec=10
TimeoutStartSec=480
TimeoutStopSec=90

[Install]
WantedBy=default.target
