{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-host workload qualification operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "plan_sha256",
    "source_commit",
    "execution",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "stage",
        "id",
        "authorization_ready",
        "target"
      ],
      "properties": {
        "state": {
          "enum": [
            "definition",
            "terminal-pending"
          ]
        },
        "stage": {
          "const": "workload_qualification"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "authorization_ready": {
          "type": "boolean"
        },
        "target": {
          "const": "j2-svpi4mf"
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "execution": {
      "$ref": "workload-execution.schema.json"
    },
    "scope": {
      "const": {
        "quiet_application_window": true,
        "synthetic_fixture_only": true,
        "application_backup_and_full_check": true,
        "preserve_fixture_and_snapshots_on_failure": true,
        "service_restart": false,
        "restore": false,
        "prune": false,
        "persistence_acceptance": false
      }
    }
  }
}
