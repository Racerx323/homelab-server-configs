{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backblaze B2 operation state",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorization_ready"],
          "properties": {
            "state": {"const": "clean"},
            "authorization_ready": {"const": false}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "targets",
        "preflight",
        "mutation_contract",
        "bucket_contract",
        "application_key_contract",
        "secret_contract",
        "acceptance",
        "failure_and_cleanup",
        "evidence",
        "authorization"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "state",
            "authorization_ready",
            "stage",
            "execution_mode",
            "source",
            "architecture",
            "procedure",
            "desired_state"
          ],
          "properties": {
            "id": {"const": "backblaze-b2-nautobot-bootstrap-v1"},
            "state": {"enum": ["definition", "pending"]},
            "authorization_ready": {"type": "boolean"},
            "stage": {"const": "provider_bootstrap"},
            "execution_mode": {"const": "operator_console_and_doppler_cli"},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "base_commit"],
              "properties": {
                "repository": {"const": "homelab-server-configs"},
                "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            },
            "architecture": {"const": "backblaze-b2/docs/B2_ARCHITECTURE.md"},
            "procedure": {"const": "backblaze-b2/docs/B2_CONFIGURATION.md"},
            "desired_state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest", "sha256", "state"],
              "properties": {
                "manifest": {"const": "backblaze-b2/manifests/desired-state.yaml"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "state": {"const": "reviewed"}
              }
            }
          }
        },
        "targets": {"$ref": "#/$defs/targets"},
        "preflight": {"$ref": "#/$defs/preflight"},
        "mutation_contract": {"$ref": "#/$defs/mutationContract"},
        "bucket_contract": {"$ref": "#/$defs/bucketContract"},
        "application_key_contract": {"$ref": "#/$defs/applicationKeyContract"},
        "secret_contract": {"$ref": "#/$defs/secretContract"},
        "acceptance": {"$ref": "#/$defs/acceptance"},
        "failure_and_cleanup": {"$ref": "#/$defs/failureAndCleanup"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "authorization": {"$ref": "#/$defs/authorization"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "definition"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": false}}
              },
              "preflight": {
                "properties": {"state": {"const": "unexecuted"}}
              },
              "authorization": {
                "properties": {
                  "command": {"const": null},
                  "mutation_authorized": {"const": false},
                  "blockers": {"minItems": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"state": {"const": "pending"}},
                "required": ["state"]
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "properties": {"authorization_ready": {"const": true}}
              },
              "preflight": {
                "properties": {"state": {"const": "passed"}}
              },
              "authorization": {
                "properties": {
                  "command": {"type": "string", "minLength": 1},
                  "mutation_authorized": {"const": false},
                  "blockers": {"maxItems": 0}
                }
              },
              "preflight": {
                "required": ["result"]
              }
            }
          }
        }
      ]
    },
    {"$ref": "replacement-key-creation.schema.json"}
  ],
  "$defs": {
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backblaze_b2", "doppler", "consumer", "host_contact_authorized"],
      "properties": {
        "backblaze_b2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account", "bucket"],
          "properties": {
            "account": {"const": "governed_administrator_account"},
            "bucket": {"const": "theama-homelab-nautobot-restic-prd"}
          }
        },
        "doppler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "environment", "config"],
          "properties": {
            "project": {"const": "homelab-dev"},
            "environment": {"const": "prd"},
            "config": {"const": "prd_b2"}
          }
        },
        "consumer": {"const": "nautobot"},
        "host_contact_authorized": {"const": false}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "procedure",
        "execution_mode",
        "execution_authorized",
        "provider_access",
        "doppler_access",
        "doppler_environment_identity_field",
        "secret_names_or_values_read",
        "global_bucket_availability_claimed",
        "draft_forms_may_be_opened",
        "draft_form_submission_authorized",
        "command_ids",
        "require",
        "evidence",
        "prohibited_during_preflight"
      ],
      "properties": {
        "state": {"enum": ["unexecuted", "passed"]},
        "procedure": {"const": "backblaze-b2/docs/READ_ONLY_PREFLIGHT.md"},
        "execution_mode": {"const": "backblaze_console_and_filtered_doppler_metadata"},
        "execution_authorized": {"const": false},
        "provider_access": {"const": "read_only_console"},
        "doppler_access": {"const": "project_environment_and_config_metadata_only"},
        "doppler_environment_identity_field": {"const": "id"},
        "secret_names_or_values_read": {"const": false},
        "global_bucket_availability_claimed": {"const": false},
        "draft_forms_may_be_opened": {"const": true},
        "draft_form_submission_authorized": {"const": false},
        "command_ids": {
          "const": [
            "doppler_project_exists",
            "doppler_prd_environment_exists",
            "doppler_prd_b2_config_absent"
          ]
        },
        "require": {"type": "array", "minItems": 1, "uniqueItems": true},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_root_pattern",
            "directory_mode",
            "file_mode",
            "raw_provider_responses_captured",
            "screenshots_captured",
            "secret_metadata_captured",
            "playwright",
            "records"
          ],
          "properties": {
            "local_root_pattern": {"const": "/tmp/backblaze-b2-preflight.*"},
            "directory_mode": {"const": "0700"},
            "file_mode": {"const": "0600"},
            "raw_provider_responses_captured": {"const": false},
            "screenshots_captured": {"const": false},
            "secret_metadata_captured": {"const": false},
            "playwright": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "session",
                "working_directory_pattern",
                "profile_directory_pattern",
                "directory_mode",
                "working_directory_within_evidence",
                "profile_directory_within_evidence",
                "artifacts_outside_evidence_allowed",
                "raw_browser_artifacts_retained"
              ],
              "properties": {
                "session": {"const": "b2preflight"},
                "working_directory_pattern": {
                  "const": "/tmp/backblaze-b2-preflight.*/playwright-work"
                },
                "profile_directory_pattern": {
                  "const": "/tmp/backblaze-b2-preflight.*/playwright-profile"
                },
                "directory_mode": {"const": "0700"},
                "working_directory_within_evidence": {"const": true},
                "profile_directory_within_evidence": {"const": true},
                "artifacts_outside_evidence_allowed": {"const": false},
                "raw_browser_artifacts_retained": {"const": false}
              }
            },
            "records": {"type": "array", "minItems": 1, "uniqueItems": true}
          }
        },
        "prohibited_during_preflight": {"type": "array", "minItems": 1, "uniqueItems": true},
        "result": {"$ref": "#/$defs/preflightResult"}
      }
    },
    "preflightResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "decision",
        "observed_region",
        "backblaze_observations_passed",
        "doppler_predicates_passed",
        "provider_or_doppler_mutation_performed",
        "secret_names_or_values_read",
        "raw_browser_artifacts_retained",
        "evidence_sha256"
      ],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "passed"},
        "observed_region": {"const": "us-west-002"},
        "backblaze_observations_passed": {"const": true},
        "doppler_predicates_passed": {"const": true},
        "provider_or_doppler_mutation_performed": {"const": false},
        "secret_names_or_values_read": {"const": false},
        "raw_browser_artifacts_retained": {"const": false},
        "evidence_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backblaze_console_observations",
            "doppler_metadata_observations",
            "manifest"
          ],
          "properties": {
            "backblaze_console_observations": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "doppler_metadata_observations": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "mutationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_classes_when_pending",
        "ordered_actions",
        "substitutions_allowed",
        "object_upload_authorized",
        "restic_initialization_authorized"
      ],
      "properties": {
        "authorized_classes_when_pending": {"type": "array", "minItems": 1, "uniqueItems": true},
        "ordered_actions": {"type": "array", "minItems": 1, "uniqueItems": true},
        "substitutions_allowed": {"const": false},
        "object_upload_authorized": {"const": false},
        "restic_initialization_authorized": {"const": false}
      }
    },
    "bucketContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository_prefix",
        "access",
        "server_side_encryption",
        "object_lock",
        "lifecycle",
        "accepted_object_count"
      ],
      "properties": {
        "name": {"const": "theama-homelab-nautobot-restic-prd"},
        "repository_prefix": {"const": ""},
        "access": {"const": "private"},
        "server_side_encryption": {"const": "backblaze_managed"},
        "object_lock": {"const": "disabled"},
        "lifecycle": {"const": "keep_only_last_version"},
        "accepted_object_count": {"const": 0}
      }
    },
    "applicationKeyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bucket_scope",
        "prefix_scope",
        "list_all_bucket_names",
        "required_file_capabilities",
        "prohibited_capability_classes",
        "provider_expiration",
        "rotation_interval_days"
      ],
      "properties": {
        "name": {"const": "homelab-nautobot-restic-prd"},
        "bucket_scope": {"const": "exact_bucket"},
        "prefix_scope": {"const": "exact_empty_prefix"},
        "list_all_bucket_names": {"const": true},
        "required_file_capabilities": {"const": ["list", "read", "write", "delete"]},
        "prohibited_capability_classes": {
          "const": [
            "bucket_administration",
            "retention_and_legal_hold_administration",
            "replication_administration",
            "governance_bypass"
          ]
        },
        "provider_expiration": {"const": "disabled"},
        "rotation_interval_days": {"const": 180}
      }
    },
    "secretContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project",
        "environment",
        "config",
        "keys",
        "values_allowed_in_git_arguments_logs_or_evidence",
        "shell_tracing_allowed_during_resolution",
        "close_provider_result_before_secret_readback"
      ],
      "properties": {
        "provider": {"const": "doppler"},
        "project": {"const": "homelab-dev"},
        "environment": {"const": "prd"},
        "config": {"const": "prd_b2"},
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["application_key_id", "application_key"],
          "properties": {
            "application_key_id": {"const": "NAUTOBOT_RESTIC_B2_APPLICATION_KEY_ID"},
            "application_key": {"const": "NAUTOBOT_RESTIC_B2_APPLICATION_KEY"}
          }
        },
        "values_allowed_in_git_arguments_logs_or_evidence": {"const": false},
        "shell_tracing_allowed_during_resolution": {"const": false},
        "close_provider_result_before_secret_readback": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require", "does_not_accept"],
      "properties": {
        "require": {"type": "array", "minItems": 1, "uniqueItems": true},
        "does_not_accept": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "failureAndCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_first_mutation",
        "after_doppler_config_creation",
        "after_bucket_creation",
        "after_key_creation_before_secret_readback",
        "lost_unstored_application_key",
        "automatic_bucket_deletion",
        "automatic_application_key_revocation",
        "automatic_doppler_config_deletion",
        "automatic_secret_overwrite"
      ],
      "properties": {
        "before_first_mutation": {"const": "cleanup_local_evidence_only"},
        "after_doppler_config_creation": {"const": "retain_config_and_stop_for_review"},
        "after_bucket_creation": {"const": "retain_empty_bucket_and_stop_for_review"},
        "after_key_creation_before_secret_readback": {"const": "keep_result_open_and_retry_protected_write"},
        "lost_unstored_application_key": {"const": "stop_and_require_separate_key_revocation_operation"},
        "automatic_bucket_deletion": {"const": false},
        "automatic_application_key_revocation": {"const": false},
        "automatic_doppler_config_deletion": {"const": false},
        "automatic_secret_overwrite": {"const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_root_pattern",
        "directory_mode",
        "file_mode",
        "raw_evidence_in_git",
        "secret_values_in_evidence",
        "records"
      ],
      "properties": {
        "local_root_pattern": {"const": "/tmp/backblaze-b2-nautobot-bootstrap.*"},
        "directory_mode": {"const": "0700"},
        "file_mode": {"const": "0600"},
        "raw_evidence_in_git": {"const": false},
        "secret_values_in_evidence": {"const": false},
        "records": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "bundle_algorithm",
        "bundle_domain_separator",
        "bundle_inputs",
        "mutation_authorized",
        "excluded_stages",
        "blockers"
      ],
      "properties": {
        "command": {"type": ["string", "null"]},
        "bundle_algorithm": {"const": "sha256"},
        "bundle_domain_separator": {"const": "backblaze-b2-nautobot-bootstrap-bundle-v1"},
        "bundle_inputs": {
          "const": [
            "backblaze-b2/docs/B2_ARCHITECTURE.md",
            "backblaze-b2/docs/B2_CONFIGURATION.md",
            "backblaze-b2/docs/READ_ONLY_PREFLIGHT.md",
            "backblaze-b2/manifests/desired-state.yaml",
            "backblaze-b2/manifests/operation.yaml",
            "backblaze-b2/schemas/desired-state.schema.json",
            "backblaze-b2/schemas/operation.schema.json"
          ]
        },
        "mutation_authorized": {"type": "boolean"},
        "excluded_stages": {"type": "array", "minItems": 1, "uniqueItems": true},
        "blockers": {"type": "array", "uniqueItems": true}
      }
    }
  }
}
