# Append at the end of sshd_config after review of existing Match precedence.
Match User wmfwdpi
    AuthenticationMethods publickey
    AuthorizedKeysFile /etc/ssh/webmin-forward/%u
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:10000
    AllowStreamLocalForwarding no
    MaxSessions 0
    PermitTTY no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
