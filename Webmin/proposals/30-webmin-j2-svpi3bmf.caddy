# Proposed application fragment; not part of the accepted Caddy release.
https://webmin-j2-svpi3bmf.local.theama.co {
    bind 10.1.0.56 fd36:5aa8:6971:1::56 {$NODE_IPV4} {$NODE_IPV6}
    import local_tls

    # Only explicitly marked diagnostic requests are recorded.
    # Drop request/response fields before encoding; never retain cookies or bodies.
    log {
        output stderr
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
                user_id delete
            }
        }
    }
    @ordinary not header_regexp X-Homelab-Diagnostic ^[0-9a-f]{32}$
    log_skip @ordinary
    log_append diagnostic_id {http.request.header.X-Homelab-Diagnostic}
    log_append upstream_host {rp.upstream.hostport}
    log_append upstream_duration_ms {rp.upstream.duration_ms}
    log_append upstream_latency_ms {rp.upstream.latency_ms}

    @allowed_clients remote_ip 10.1.0.0/22 fd36:5aa8:6971:1::/64
    handle @allowed_clients {
        reverse_proxy 10.1.3.75:10000 [fd36:5aa8:6971:1::75]:10000 {
            lb_policy first

            health_method GET
            health_uri /session_login.cgi
            health_status 200
            health_interval 30s
            health_timeout 5s
            health_passes 1
            health_fails 3
            health_headers {
                X-Homelab-Health webmin-browser-health
                Host webmin-j2-svpi3bmf.local.theama.co
                X-Forwarded-Host webmin-j2-svpi3bmf.local.theama.co
                X-Forwarded-Proto https
                User-Agent homelab-proxy-diagnostic
                Accept */*
                Accept-Encoding identity
                Connection close
            }

            # Both addresses reach one Webmin process; paired checks share its resource budget.
            fail_duration 0s
            max_fails 1
            unhealthy_status 5xx
            header_up Host webmin-j2-svpi3bmf.local.theama.co

            transport http {
                dial_timeout 3s
                response_header_timeout 60s
                # Avoid idle HTTP reuse races; WebSocket upgrades remain supported.
                keepalive off
                # HTTP is confined to the source-restricted internal backend path.
            }
        }
    }

    respond 403
}
