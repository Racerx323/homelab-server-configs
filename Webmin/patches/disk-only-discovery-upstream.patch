+		$disk->{'prefix'} = $disk->{'device'}.'p';
+		}
+	elsif ($disk->{'device'} =~ /\/(cciss\/c(\d+)d(\d+))/) {
+		# Compaq Smart Array RAID
+		local ($ic, $id) = ($2, $3);
+		$disk->{'desc'} = &text('select_smart', $ic, $id);
+		open(CCI, "</proc/driver/cciss/cciss$ic");
+		while(<CCI>) {
+			if (/^\s*(\S+):\s*(.*)/ && $1 eq "cciss$ic") {
+				$disk->{'model'} = $2;
+				}
+			}
